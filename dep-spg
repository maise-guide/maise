#!/bin/bash

ver="1.11.2.1"
url="https://github.com/spglib/spglib/archive/v${ver}.tar.gz"

root="$PWD"
depdir="$root/dep-ext"
libdir="$root/lib"
archive="$depdir/spglib.tar.gz"
srcdir="$depdir/spglib-$ver"
log="$depdir/spglib.log"

mkdir -p "$depdir" "$libdir/include"
: > "$log"

fail() {
    echo "$1"
    echo "$1" >> "$log"
    echo "spglib installation failed!"
    exit 1
}

run() {
    echo "+ $*" >> "$log"
    "$@" >> "$log" 2>&1
}

download_spglib() {
    echo "downloading...spglib-$ver to $depdir"
    echo "downloading...spglib-$ver to $depdir" >> "$log"

    if command -v wget >/dev/null 2>&1; then
        run wget -q "$url" -O "$archive" || fail "ERROR: failed to download SPGLIB with wget"
    elif command -v curl >/dev/null 2>&1; then
        run curl -fsSL "$url" -o "$archive" || fail "ERROR: failed to download SPGLIB with curl"
    else
        fail "ERROR: neither wget nor curl is available"
    fi
}

unpack_spglib() {
    echo "unpacking.....in $depdir"
    echo "unpacking.....in $depdir" >> "$log"
    run tar -xf "$archive" -C "$depdir" || fail "ERROR: failed to unpack $archive"
}

copy_artifacts() {
    local built_lib="$1"

    if [ ! -s "$built_lib" ]; then
        fail "ERROR: SPGLIB static library was not created"
    fi

    if [ ! -s "$srcdir/src/spglib.h" ]; then
        fail "ERROR: SPGLIB header src/spglib.h was not found"
    fi

    echo "installing....to $libdir"
    echo "installing....to $libdir" >> "$log"

    cp "$built_lib" "$libdir/libsymspg.a" >> "$log" 2>&1 || fail "ERROR: failed to copy libsymspg.a"
    cp "$srcdir/src/spglib.h" "$libdir/include/spglib.h" >> "$log" 2>&1 || fail "ERROR: failed to copy spglib.h"
}

build_with_cmake() {
    local builddir="$srcdir/_maise_build"
    local built_lib=""

    command -v cmake >/dev/null 2>&1 || return 1

    echo "compiling.....in $srcdir with cmake"
    echo "compiling.....in $srcdir with cmake" >> "$log"

    mkdir -p "$builddir" || return 1
    cd "$builddir" || return 1

    if ! run cmake .. -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_INSTALL_PREFIX=/usr/local; then
        cd "$root" || true
        return 1
    fi

    if ! run make symspg_static; then
        cd "$root" || true
        return 1
    fi

    built_lib="$(find "$builddir" -name 'libsymspg.a' -type f 2>/dev/null | head -n 1)"

    cd "$root" || return 1

    if [ -n "$built_lib" ] && [ -s "$built_lib" ]; then
        copy_artifacts "$built_lib"
        return 0
    fi

    return 1
}

build_directly() {
    local cc="${CC:-gcc}"
    local builddir="$srcdir/_maise_direct"
    local objs=""
    local src=""
    local base=""
    local obj=""

    command -v "$cc" >/dev/null 2>&1 || fail "ERROR: C compiler '$cc' was not found"
    command -v ar >/dev/null 2>&1 || fail "ERROR: ar was not found"

    echo "compiling.....in $srcdir directly with $cc"
    echo "compiling.....in $srcdir directly with $cc" >> "$log"

    mkdir -p "$builddir" || fail "ERROR: failed to create direct build directory"
    rm -f "$builddir"/*.o "$builddir"/libsymspg.a

    cd "$srcdir" || fail "ERROR: failed to enter $srcdir"

    for src in src/*.c; do
        base="$(basename "$src")"

        if [ "$base" = "test.c" ]; then
            continue
        fi

        obj="$builddir/${base%.c}.o"

        echo "+ $cc -O3 -fPIC -Isrc -c $src -o $obj" >> "$log"
        "$cc" -O3 -fPIC -Isrc -c "$src" -o "$obj" >> "$log" 2>&1 || fail "ERROR: direct SPGLIB compilation failed at $base"

        objs="$objs $obj"
    done

    cd "$root" || fail "ERROR: failed to return to $root"

    if [ -z "${objs// /}" ]; then
        fail "ERROR: no SPGLIB source files were compiled"
    fi

    run ar rcs "$builddir/libsymspg.a" $objs || fail "ERROR: failed to create libsymspg.a with ar"

    if command -v ranlib >/dev/null 2>&1; then
        run ranlib "$builddir/libsymspg.a" || true
    fi

    copy_artifacts "$builddir/libsymspg.a"
}

if [ ! -s "$archive" ]; then
    download_spglib
fi

if [ ! -d "$srcdir" ]; then
    unpack_spglib
fi

if [ ! -d "$srcdir" ]; then
    fail "ERROR: SPGLIB source directory $srcdir was not created"
fi

if ! build_with_cmake; then
    echo "cmake build did not produce libsymspg.a; falling back to direct static build"
    echo "cmake build did not produce libsymspg.a; falling back to direct static build" >> "$log"
    build_directly
fi

if [ ! -s "$libdir/libsymspg.a" ]; then
    fail "ERROR: final check failed: $libdir/libsymspg.a is missing"
fi

if [ ! -s "$libdir/include/spglib.h" ]; then
    fail "ERROR: final check failed: $libdir/include/spglib.h is missing"
fi

echo "Done"
